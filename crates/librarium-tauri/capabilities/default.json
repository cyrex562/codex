{
  "$schema": "https://schema.tauri.app/config/2/acl/capability.json",
  "identifier": "default",
  "description": "Default capability set for the Librarium desktop app",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "deep-link:default",
    "allow-open-directory-dialog",
    "allow-notify",
    "allow-open-external-url",
    "allow-frontend-log",
    "allow-frontend-log-path",
    "allow-sync-add-remote",
    "allow-sync-map-vault",
    "allow-sync-list-remotes",
    "allow-sync-list-remote-vaults",
    "allow-sync-create-remote-vault",
    "allow-sync-remove-remote",
    "allow-sync-unmap-vault",
    "allow-sync-status",
    "allow-sync-start",
    "allow-sync-stop"
  ]
}
