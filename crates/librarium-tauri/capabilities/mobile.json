{
  "$schema": "https://schema.tauri.app/config/2/acl/capability.json",
  "identifier": "mobile",
  "description": "Mobile-only capability set (Route C 21, #64): the background reconcile service, whose plugin (tauri-plugin-background-service) is only a dependency on Android/iOS — see librarium-tauri/Cargo.toml's target-cfg gating.",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "background-service:default",
    "allow-notify",
    "allow-open-external-url",
    "allow-frontend-log",
    "allow-frontend-log-path",
    "allow-vault-list",
    "allow-vault-get",
    "allow-file-tree",
    "allow-file-read",
    "allow-file-write",
    "allow-file-create",
    "allow-file-delete",
    "allow-file-rename",
    "allow-directory-create",
    "allow-render-markdown",
    "allow-render-markdown-in-vault",
    "allow-resolve-wiki-link",
    "allow-backlinks",
    "allow-outgoing-links",
    "allow-tags-list",
    "allow-tag-files",
    "allow-frontmatter-read",
    "allow-frontmatter-write",
    "allow-search",
    "allow-search-paged",
    "allow-search-index-rebuild",
    "allow-search-index-size",
    "allow-preferences-get",
    "allow-preferences-set",
    "allow-preferences-reset",
    "allow-recent-list",
    "allow-recent-record",
    "allow-favorites-list",
    "allow-favorites-add",
    "allow-favorites-remove",
    "allow-bookmarks-list",
    "allow-bookmarks-add",
    "allow-bookmarks-remove",
    "allow-sync-add-remote",
    "allow-sync-map-vault",
    "allow-sync-list-remotes",
    "allow-sync-list-remote-vaults",
    "allow-sync-create-remote-vault",
    "allow-sync-remove-remote",
    "allow-sync-unmap-vault",
    "allow-sync-status",
    "allow-sync-start",
    "allow-sync-stop",
    "allow-pairing-set",
    "allow-pairing-get",
    "allow-pairing-clear",
    "allow-sync-get-policy",
    "allow-sync-set-policy",
    "allow-sync-reconcile-once"
  ]
}
